ption\": \"Управление правами доступа для этой роли.\",\n                \"deleteRoleButton\": \"Удалить эту роль\",\n                \"clear\": \"Очистить\",\n                \"roleIcon\": \"Иконка роли\",\n                \"managedByBot\": \"Эта роль управляется {{botName}}. Вы не можете удалить её или выдать её участникам. Выгоните бота, чтобы удалить эту роль.\",\n                \"applyOnJoin\": \"Применить при присоединении\",\n                \"applyOnJoinDescription\": \"Выдавать роль участникам, как только они заходят на сервер.\",\n                \"deleteRoleTitle\": \"Удалить {{roleName}}\"\n            },\n            \"header\": {\n                \"editServer\": \"Редактировать сервер\",\n                \"serverMemberCount\": \"{{count}} участников\"\n            },\n            \"channels\": {\n                \"createButton\": \"Создать\",\n                \"createNewDescription\": \"Создать новый канал или категорию\",\n                \"textChannel\": \"Текстовый канал\",\n                \"category\": \"Категория\"\n            },\n            \"channel\": {\n                \"channelName\": \"Название канала\",\n                \"permissionsDescription\": \"Управление разрешениями для этого канала.\",\n                \"deleteThisChannel\": \"Удалить этот канал\",\n                \"deleteChannelButton\": \"Удалить канал\",\n                \"removeNoticeButton\": \"Удалить примечание\",\n                \"channelIcon\": \"Иконка канала\",\n                \"slowModeDescription\": \"Укажите, сколько участник должен подождать, чтобы отправить сообщение.\",\n                \"deleteChannelTitle\": \"Удалить {{channelName}}\",\n                \"slowMode\": \"Медленный режим\",\n                \"channelNotice\": \"Примечание канала\",\n                \"channelNoticeDescription\": \"Отображается, когда кто-либо впервые собирается общаться в чате. Изменения вступят в силу после перезагрузки страницы.\",\n                \"channelNoticeTooLong\": \